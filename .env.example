# MLOps Assignment 2 — Local Environment Variables
# WARNING: This file is for LOCAL DEVELOPMENT ONLY.
# The Kaggle notebook must use Kaggle Secrets (Add-ons → Secrets).
# NEVER commit this file to GitHub.

# Weights & Biases API Key
# Get from: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here

# Hugging Face Hub Token (Write access required)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_write_token_here

# Kaggle API Credentials (optional — for local dataset download)
# Get from: https://www.kaggle.com/settings/account → API → Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
